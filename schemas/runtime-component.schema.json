{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-component.schema.json",
  "title": "Runtime Component Record",
  "type": "object",
  "required": ["component_id", "layer", "function", "canonical_status", "version"],
  "properties": {
    "component_id": {"type": "string"},
    "layer": {"type": "string"},
    "function": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "state_model": {"type": ["string", "null"]},
    "failure_mode": {"type": ["string", "null"]},
    "recovery_path": {"type": ["string", "null"]},
    "telemetry_emitted": {"type": "array", "items": {"type": "string"}},
    "governance_boundary": {"type": ["string", "null"]},
    "security_class": {"type": ["string", "null"]},
    "canonical_status": {"enum": ["canonical", "provisional", "proposed", "unknown"]},
    "repository_path": {"type": ["string", "null"]},
    "version": {"type": "string"},
    "timestamp": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
